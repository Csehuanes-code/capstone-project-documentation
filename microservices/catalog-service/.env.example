# Configuration template for Catálogo microservice
# Copy this file to .env and configure real credentials locally (DO NOT COMMIT .env TO GIT)

ENVIRONMENT=development
# Puertos del grupo: IA 8000, Auth 8001, Catálogo 8002, Reservas 8003, Analítica 8004
PORT=8002
DEBUG=true

# PostgreSQL 16
POSTGRES_DB=catalogo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/catalogo_db

# Reservas Service URL (for synchronous checks)
RESERVAS_SERVICE_URL=http://localhost:8003
RESERVAS_TIMEOUT_SECONDS=1.0

# Security (JWT, ADR-06): tokens ES256 emitidos por Auth. Configure UNA de las dos opciones:
#   - JWT_PUBLIC_KEY_FILE: ruta al PEM de la clave PÚBLICA de Auth (no la privada), o
#   - JWT_JWKS_URL: el endpoint /jwks de Auth (ej. http://localhost:8001/jwks)
# Sin ninguna, las rutas protegidas responden 401.
JWT_PUBLIC_KEY_FILE=secrets/auth-es256-public.pem
JWT_JWKS_URL=
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=santa-marta-platform

# RabbitMQ (ADR-04): publica los eventos del outbox en el exchange 'turismo'.
# Vacío = los eventos esperan en la tabla outbox sin publicarse.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# In-Memory Mode (set to true for running tests or standalone without Postgres)
USE_IN_MEMORY_REPO=false

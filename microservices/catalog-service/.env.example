# Configuration template for Catálogo microservice
# Copy this file to .env and configure real credentials locally (DO NOT COMMIT .env TO GIT)

ENVIRONMENT=development
PORT=8001
DEBUG=true

# PostgreSQL 16
POSTGRES_DB=catalogo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/catalogo_db

# Reservas Service URL (for synchronous checks)
RESERVAS_SERVICE_URL=http://localhost:8002
RESERVAS_TIMEOUT_SECONDS=1.0

# Security (JWT)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256

# In-Memory Mode (set to true for running tests or standalone without Postgres)
USE_IN_MEMORY_REPO=false

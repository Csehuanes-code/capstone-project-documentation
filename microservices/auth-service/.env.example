POSTGRES_DB=auth_db
POSTGRES_USER=auth
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
AUTH_DATABASE_URL=postgresql+asyncpg://auth:replace-with-a-local-password@127.0.0.1:5432/auth_db
AUTH_JWT_PRIVATE_KEY_FILE=secrets/auth-es256.pem
AUTH_JWT_KID=local-dev-1
AUTH_JWT_ISSUER=http://localhost:8000
AUTH_JWT_AUDIENCE=santa-marta-platform
AUTH_LOGIN_LOCKOUT_SECONDS=300
